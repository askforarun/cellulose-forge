title = I-beta OpenFF Sage anisotropic NPT production
integrator = md
dt = 0.002
nsteps = 50000000
continuation = yes
constraints = h-bonds
constraint-algorithm = lincs
cutoff-scheme = Verlet
nstlist = 20
coulombtype = PME
rcoulomb = 0.9
vdwtype = Cut-off
vdw-modifier = Potential-switch
rvdw-switch = 0.8
rvdw = 0.9
DispCorr = EnerPres
periodic-molecules = yes
tcoupl = v-rescale
tc-grps = System
tau-t = 1.0
ref-t = 300
pcoupl = Parrinello-Rahman
pcoupltype = anisotropic
tau-p = 5.0
ref-p = 1.0 1.0 1.0 0.0 0.0 0.0
compressibility = 4.5e-5 4.5e-5 4.5e-5 4.5e-5 4.5e-5 4.5e-5
gen-vel = no
nstenergy = 500
nstlog = 500
nstxout-compressed = 5000
