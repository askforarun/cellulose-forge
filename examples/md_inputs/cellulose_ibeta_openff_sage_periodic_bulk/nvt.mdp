; One-ps NVT smoke test for covalently periodic chains; not a production protocol.
integrator              = md
dt                      = 0.001
nsteps                  = 1000
continuation            = no
gen-vel                 = yes
gen-temp                = 300
gen-seed                = -1
cutoff-scheme           = Verlet
nstlist                 = 20
coulombtype             = PME
rcoulomb                = 0.9
fourierspacing          = 0.12
pme-order               = 4
vdwtype                 = Cut-off
vdw-modifier            = Potential-switch
rvdw-switch             = 0.8
rvdw                    = 0.9
DispCorr                = EnerPres
pbc                     = xyz
periodic-molecules      = yes
constraints             = h-bonds
constraint-algorithm    = lincs
lincs-order             = 4
lincs-iter              = 1
tcoupl                  = v-rescale
tc-grps                 = System
tau-t                   = 0.5
ref-t                   = 300
pcoupl                  = no
nstxout-compressed      = 100
nstenergy               = 100
nstlog                  = 100
nstcalcenergy           = 100
comm-mode               = Linear
nstcomm                 = 100
