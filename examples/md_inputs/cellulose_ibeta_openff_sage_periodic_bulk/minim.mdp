; Steepest-descent minimization for covalently periodic chains.
integrator              = steep
nsteps                  = 10000
emtol                   = 1000.0
emstep                  = 0.01
cutoff-scheme           = Verlet
nstlist                 = 20
coulombtype             = PME
rcoulomb                = 0.9
fourierspacing          = 0.12
pme-order               = 4
vdwtype                 = Cut-off
vdw-modifier            = Potential-switch
rvdw-switch             = 0.8
rvdw                    = 0.9
DispCorr                = EnerPres
pbc                     = xyz
periodic-molecules      = yes
constraints             = none
