; One-ps NVT smoke test for chemically capped finite chains; not a production protocol.
integrator              = md
dt                      = 0.001
nsteps                  = 1000
continuation            = no
gen-vel                 = yes
gen-temp                = 300
gen-seed                = -1
; CHARMM36 CROSS-ENGINE SMOKE-TEST SETTINGS, NOT THE CHARMM36 PRODUCTION
; PROTOCOL.  The plain 1.0 nm cut-off matches the validated GROMACS/OpenMM
; comparison (OpenMM cannot reproduce the CHARMM force switch).  For
; production use vdw-modifier = force-switch, rvdw-switch = 1.0 and
; rvdw = rcoulomb = 1.2, which requires every box height above 2.4 nm.
cutoff-scheme           = Verlet
nstlist                 = 20
rlist                   = 1.0
coulombtype             = PME
rcoulomb                = 1.0
fourierspacing          = 0.12
pme-order               = 4
vdwtype                 = Cut-off
rvdw                    = 1.0
DispCorr                = no
pbc                     = xyz
periodic-molecules      = no
constraints             = h-bonds
constraint-algorithm    = lincs
lincs-order             = 4
lincs-iter              = 1
tcoupl                  = v-rescale
tc-grps                 = System
tau-t                   = 0.5
ref-t                   = 300
pcoupl                  = no
nstxout-compressed      = 100
nstenergy               = 100
nstlog                  = 100
nstcalcenergy           = 100
comm-mode               = Linear
nstcomm                 = 100
