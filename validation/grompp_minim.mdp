; Minimal preprocessing check for generated cellulose systems.
integrator              = steep
nsteps                  = 50
emtol                   = 1000.0
emstep                  = 0.01
cutoff-scheme           = Verlet
nstlist                 = 10
rlist                   = 0.5
coulombtype             = Cut-off
rcoulomb                = 0.5
vdwtype                 = Cut-off
rvdw                    = 0.5
pbc                     = xyz
constraints             = none
