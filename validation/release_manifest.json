{
  "description": "Every file under validation/results/ and the role it plays in a release. Read by validation/release_gate.py and tests/unit/test_validation_provenance.py.",
  "roles": {
    "evidence": "Cited validation result. Must record provenance; at release it must come from a clean tree, and the source tree and its validator must be unchanged since the recorded commit.",
    "unprovenanced-evidence": "Cited validation result whose validator does not yet record provenance. Reported in every run; blocks a --release run until the validator records provenance and the result is regenerated.",
    "reference": "Fixture or probe consumed by other validators or kept for the record. Must exist; not release evidence."
  },
