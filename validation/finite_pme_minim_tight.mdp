; Tight PME minimization before finite-chain NVT validation.
integrator              = steep
nsteps                  = 20000
emtol                   = 100.0
emstep                  = 0.005
cutoff-scheme           = Verlet
nstlist                 = 20
rlist                   = 1.0
coulombtype             = PME
rcoulomb                = 1.0
fourierspacing          = 0.12
pme-order               = 4
vdwtype                 = Cut-off
rvdw                    = 1.0
DispCorr                 = no
pbc                     = xyz
constraints             = none
