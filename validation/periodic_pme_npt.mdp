; Short NPT smoke test for a covalently periodic cellulose bulk crystal.
integrator              = md
dt                      = 0.001
nsteps                  = 10000

continuation            = yes
gen-vel                 = no

cutoff-scheme           = Verlet
nstlist                 = 20
rlist                   = 1.0
coulombtype             = PME
rcoulomb                = 1.0
fourierspacing          = 0.12
pme-order               = 4
vdwtype                 = Cut-off
rvdw                    = 1.0
DispCorr                = no

pbc                     = xyz
periodic-molecules      = yes
constraints             = h-bonds
constraint-algorithm    = lincs
lincs-order             = 4
lincs-iter              = 1

tcoupl                  = v-rescale
tc-grps                 = System
tau-t                   = 0.5
ref-t                   = 300

; Preserve the experimental monoclinic shape while relaxing the bulk volume.
pcoupl                  = C-rescale
pcoupltype              = isotropic
tau-p                   = 5.0
ref-p                   = 1.0
compressibility         = 4.5e-5

nstxout-compressed      = 100
nstenergy               = 100
nstlog                  = 100
nstcalcenergy           = 100

comm-mode               = Linear
nstcomm                 = 100
