{
  "schema_version": 1,
  "system": "replace-with-system-name",
  "coordinate_file": "shared/coordinates.g96",
  "coordinate_sha256": "replace-with-shared-coordinate-sha256",
  "reference_engine": "gromacs",
  "absolute_tolerance_kj_mol": 0.05,
  "relative_tolerance": 0.00001,
  "required_terms": ["bond", "angle", "dihedral", "improper", "vdw", "electrostatics", "potential"],
  "engines": {
    "gromacs": {
      "directory": "gromacs",
      "adapter": "gromacs",
      "inputs": {
        "coordinate_file": "../shared/coordinates.gro",
        "topology_file": "system.top",
        "mdp_file": "single_point.mdp",
        "executable": "gmx"
      }
    },
    "openmm": {
      "directory": "openmm",
      "adapter": "openmm",
      "inputs": {
        "system_file": "system-unconstrained.xml",
        "coordinate_file": "../shared/coordinates.gro",
        "platform_name": "Reference",
        "classification": {
          "urey_bradley_bonds": {"0": [12, 13]},
          "periodic_impropers": {"2": []},
          "rb_impropers": {},
          "force_roles": {"5": "harmonic_improper"}
        }
      }
    },
    "lammps": {"directory": "lammps", "command": ["python", "run_single_point.py"]},
    "namd": {
      "directory": "namd",
      "adapter": "namd",
      "optional": true,
      "inputs": {
        "configuration_file": "single_point_namd.conf",
        "coordinate_file": "../shared/coordinates.gro",
        "binary_coordinate_file": "single_point.coor",
        "executable": "namd3",
        "threads": 1,
        "classified_terms": {}
      }
    },
    "amber": {"directory": "amber", "command": ["python", "run_single_point.py"], "optional": true}
  }
}
