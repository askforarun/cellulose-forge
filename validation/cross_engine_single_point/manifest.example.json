{
  "schema_version": 1,
  "system": "replace-with-system-name",
  "coordinate_reference_file": "shared/coordinate_reference.json",
  "coordinate_sha256": "replace-with-coordinate-reference-sha256",
  "reference_engine": "gromacs",
  "absolute_tolerance_kj_mol": 0.1,
  "relative_tolerance": 0.0001,
  "term_tolerances": {"electrostatics": [0.1, 0.0002]},
  "required_terms": ["bond", "angle", "dihedral", "improper", "vdw", "electrostatics", "potential"],
  "engines": {
    "gromacs": {
      "directory": "gromacs",
      "adapter": "gromacs",
      "inputs": {
        "coordinate_file": "../shared/coordinates.gro",
        "topology_file": "system.top",
        "mdp_file": "single_point.mdp",
        "executable": "gmx"
      }
    },
    "openmm": {
      "directory": "openmm",
      "adapter": "openmm",
      "inputs": {
        "system_file": "system-unconstrained.xml",
        "coordinate_file": "../shared/coordinates.gro",
        "platform_name": "Reference",
        "classification": {
          "urey_bradley_bonds": {"0": [12, 13]},
          "periodic_impropers": {"2": []},
          "rb_impropers": {},
          "force_roles": {"5": "harmonic_improper"}
        }
      }
    },
    "lammps": {
      "directory": "lammps",
      "adapter": "lammps",
      "inputs": {
        "input_file": "in.cellulose",
        "data_file": "system.data",
        "executable": "lmp",
        "periodic_improper_count": 0,
        "periodic_improper_kj_mol": null,
        "explicit_pair_kj_mol": null
      }
    },
    "namd": {
      "directory": "namd",
      "adapter": "namd",
      "optional": true,
      "inputs": {
        "configuration_file": "single_point_namd.conf",
        "binary_coordinate_file": "single_point.coor",
        "executable": "namd3",
        "threads": 1,
        "classified_terms": {}
      }
    },
    "amber": {
      "directory": "amber",
      "adapter": "amber",
      "optional": true,
      "inputs": {
        "input_file": "single_point.in",
        "topology_file": "structure.prmtop",
        "amber_coordinate_file": "structure.inpcrd",
        "executable": "sander",
        "periodic_improper_kcal_mol": 0.0
      }
    }
  }
}
