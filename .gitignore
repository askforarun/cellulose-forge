__pycache__/
*.py[cod]
*.egg-info/
.coverage
.mypy_cache/
.pytest_cache/
.ruff_cache/
.venv/
build/
dist/
htmlcov/
site/
tmp/
.DS_Store
mdout.mdp

# The SoftwareX manuscript is maintained outside version control.
softwarex/

# Third-party reference distributions and locally downloaded literature are
# cited in the provenance documentation rather than vendored in this project.
legacy/cellulose-builder-2013/
legacy/doglycans-2017/
legacy/source-archives/
legacy/publications/
legacy/SI_Cellulosewetting/
legacy/*.zip
legacy/*.tgz
legacy/*.tar.gz

# VMD-rendered screenshots are rendering scratch output, not curated examples.
**/vmdscene.tga

# Regenerable coordinate demonstrations; retain only curated examples.
/examples/bulk/
/examples/slabs/
/examples/ibeta_*.pdb
/examples/ibeta_*.build_report.json

# Microsoft Office lock files.
~$*

# AmberTools intermediates. The PDB and GROMACS TOP files are retained as
# compact, independently generated test fixtures.
examples/glycam/**/*.gro
examples/glycam/**/*.inpcrd
examples/glycam/**/*.json
examples/glycam/**/*.leap
examples/glycam/**/*.prmtop

# Regenerable bulk outputs from the agent-orchestration demonstration.
# build_report.json is the retained evidence artifact; run cellulose-forge
# build (see validation/agent_orchestration_demo/README.md) to regenerate the
# large coordinate and topology files.
validation/agent_orchestration_demo/**/*.pdb
validation/agent_orchestration_demo/**/*.gro
validation/agent_orchestration_demo/**/*.top

# Regenerable force-field comparison trajectories and run directories. Only
# curated compact evidence under validation/results is versioned.
validation/work/
validation/results/force_field_comparison/**/*.xtc
validation/results/force_field_comparison/**/*.trr
validation/results/force_field_comparison/**/*.edr
validation/results/force_field_comparison/**/*.tpr
validation/results/force_field_comparison/**/*.cpt
